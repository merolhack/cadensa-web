# ==============================================================================
# CADENSA - ENVIRONMENT VARIABLES EXAMPLE
# ==============================================================================
# Renombra este archivo a `.env.local` y reemplaza los valores de prueba
# con tus credenciales reales (las puedes obtener tras ejecutar `supabase start`).

# [SUPABASE - PUBLIC]
# Estas variables estarán disponibles en el frontend. Toda la seguridad
# de acceso a datos está garantizada mediante RLS en PostgreSQL.
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54421"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"

# ¡NUNCA EXPONGAS LA CLAVE SERVICE_ROLE (SECRETA) EN EL FRONTEND!

# ==============================================================================
# [GITHUB ACTIONS CI/CD SECRETS]
# Variables que debes configurar directamente en Github > Settings > Secrets:
# - CLOUDFLARE_API_TOKEN
# - CLOUDFLARE_ACCOUNT_ID
# ==============================================================================
