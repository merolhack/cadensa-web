{
  "name": "cadensa-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:bdd": "tsx ./node_modules/.bin/cucumber-js",
    "test:all": "npm run test && npm run test:bdd",
    "db:migrate": "node scripts/migrate_supabase.cjs",
    "security:audit": "node scripts/security_audit.cjs && npm audit",
    "supabase:gen-types": "npx supabase gen types typescript --local > src/types/supabase.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.2",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^12.9.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "eslint-config-next": "^16.4.3",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
