# ==============================================================================
# CADENSA - ENVIRONMENT VARIABLES EXAMPLE
# ==============================================================================
# Renombra o copia este archivo a `.env` o `.env.local` y reemplaza los valores de ejemplo
# con tus credenciales reales obtenidas de Cloudflare Dashboard y Supabase Dashboard.

# [CLOUDFLARE - GITHUB ACTIONS CI/CD SECRETS]
# Variables para despliegue automatizado a Cloudflare Pages:
# https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here

# [SUPABASE - PUBLIC FRONTEND]
# Estas variables estarán disponibles en el frontend. Toda la seguridad
# de acceso a datos está garantizada mediante RLS en PostgreSQL.
# https://supabase.com/dashboard/project/<project-ref>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# [SUPABASE - CLI & MIGRATIONS]
# Token de acceso personal generado en https://supabase.com/dashboard/account/tokens
# Permite ejecutar migraciones y administrar la base de datos sin intervención manual.
SUPABASE_ACCESS_TOKEN=your_personal_access_token_here

# [GOOGLE OAUTH 2.0 - GCP CREDENTIALS]
# Credenciales OAuth 2.0 generadas en Google Cloud Console para autenticación delegada:
# https://console.cloud.google.com/auth/clients?project=cadensa-web-dev
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# [GITGUARDIAN - API SECURITY SCANNING]
# Personal Access Token generado en GitGuardian Dashboard:
# https://dashboard.gitguardian.com/api/tokens
GITGUARDIAN_API_KEY=your_gitguardian_api_key_here

# [BING WEBMASTER TOOLS - API KEY]
# Clave API generada en Bing Webmaster Tools Portal:
# https://www.bing.com/webmasters/
BING_API_KEY=your_bing_api_key_here
